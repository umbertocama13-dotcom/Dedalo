# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (MySQL 8 / MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=dedalo
DB_PASSWORD=change_me
DB_NAME=dedalo
# Separate database used only by pytest (recreated from schema.sql + seed.sql)
DB_TEST_NAME=dedalo_test

# --- Authentication (JWT) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- Semantic matching ---
# Defaults are calibrated on tests/fixtures/operator_queries.json with scripts/evaluate_matching.py:
# change them only after re-running the script on your own data.
# Local embedding model (downloaded once from Hugging Face, then used offline)
EMBEDDING_MODEL=nickprock/sentence-bert-base-italian-xxl-uncased
# Some models need prefixes, e.g. intfloat/multilingual-e5-base wants "query: " and "passage: "
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=
# true = score is the higher of semantic similarity and fuzzy string similarity (helps with typos)
SEMANTIC_USE_FUZZY=true
# Scores are 0-1. Below RECALL nothing is shown; between RECALL and MATCH hypotheses are shown as uncertain.
SEMANTIC_RECALL_THRESHOLD=0.50
SEMANTIC_MATCH_THRESHOLD=0.65
# A choice question is proposed when two different symptoms score closer than this gap
DISAMBIGUATION_SCORE_GAP=0.05
# Softmax temperature turning scores into probabilities: lower = more weight to the best hypothesis
PROBABILITY_TEMPERATURE=0.03
# Score of "none of these hypotheses" in the same softmax: a hypothesis scoring well above it keeps
# almost all the probability, a weaker one leaves most of it to "none of these"
PROBABILITY_UNKNOWN_SCORE=0.60
# Maximum hypotheses shown to the operator
MAX_CANDIDATES=5

# --- AI provider: none | api | local ---
# none  = deterministic only (default, no text leaves the machine)
# api   = external paid API: the conversation is sent OUTSIDE the company network
# local = model served by Ollama on internal infrastructure
AI_PROVIDER=none
# Maximum questions the model may ask in one conversation
MAX_LLM_QUESTIONS=3
# Seconds before a model request is abandoned (the answer then falls back to deterministic)
AI_TIMEOUT_SECONDS=30

# Used only when AI_PROVIDER=api (OpenAI-compatible chat completions API).
# Base URL without the endpoint, e.g. https://api.openai.com/v1 — /chat/completions is appended.
AI_API_URL=
AI_API_KEY=
AI_API_MODEL=

# Used only when AI_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# --- Server (read by run.py) ---
# 127.0.0.1 = reachable only from this machine; 0.0.0.0 = reachable from the local network
APP_HOST=127.0.0.1
APP_PORT=8000
# true = restart automatically on code changes (development only)
APP_RELOAD=false

# --- Frontend ---
CORS_ORIGINS=http://localhost:5173

# --- Logging: DEBUG | INFO | WARNING | ERROR ---
LOG_LEVEL=INFO
