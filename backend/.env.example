# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (MySQL 8 / MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=dedalo
DB_PASSWORD=change_me
DB_NAME=dedalo
# Separate database used only by pytest (recreated from schema.sql + seed.sql)
DB_TEST_NAME=dedalo_test

# --- Authentication (JWT) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- Matching engine ---
# Minimum rapidfuzz score (0-100) for a candidate to be considered a match
MATCH_SCORE_THRESHOLD=80

# --- AI provider: none | api | local ---
# none  = deterministic only (default, no text leaves the machine)
# api   = external paid API: operator text is sent OUTSIDE the company network
# local = model served by Ollama on internal infrastructure
AI_PROVIDER=none

# Used only when AI_PROVIDER=api
AI_API_URL=
AI_API_KEY=
AI_API_MODEL=

# Used only when AI_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# --- Frontend ---
CORS_ORIGINS=http://localhost:5173
